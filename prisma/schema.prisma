// Prisma Schema for FECT Exam Management System
// Faculty of Engineering & Computer Science (FECT)
// Somali International University (SIU)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Admin Users Model
model AdminUser {
  id        String   @id @default(cuid())
  fullName  String
  username  String   @unique
  password  String   // Hashed password
  email     String?  @unique
  phone     String?
  userType  UserType @default(ADMIN)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

enum UserType {
  ADMIN
  DEAN
  HOD
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

// Department Model
model Department {
  id        String   @id @default(cuid())
  name      String   @unique // e.g., "Computer Science", "Civil Engineering"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes   Class[]
  timetables Timetable[]
  courses   Course[]
  lecturers Lecturer[]

  @@map("departments")
}

// Class Model
model Class {
  id           String     @id @default(cuid())
  classTitle   String     // e.g., "CS-2024-A", "CE-2024-B"
  departmentId String
  room         String?    // Class room/location
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  timetables   Timetable[]

  @@index([departmentId])
  @@map("classes")
}

// Student Model
model Student {
  id        String   @id @default(cuid())
  studentId String   @unique // e.g., SIU-2023-0000
  fullName  String
  department String?  // Department name (Computer Science, Civil Engineering) - nullable for migration
  classId   String?  // Reference to Class
  semester  String   // Semester 1, 2, 3, etc.
  shift     Shift    @default(FULL_TIME)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
  @@map("students")
}

enum Shift {
  FULL_TIME
  PART_TIME
}

// Registration Form Model (Admin creates these)
model RegistrationForm {
  id          String   @id @default(cuid())
  formName    String   // e.g., "Final Semester Special Exam 2024"
  description String?
  formType    FormType @default(SPECIAL_EXAM)
  isOpen      Boolean  @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?  // Admin user ID

  registrations SpecialExamRegistration[]

  @@map("registration_forms")
}

enum FormType {
  SPECIAL_EXAM
  CLEARANCE_EXAM
  ADMINISTRATIVE
  RESIT_EXAM
  IMPROVEMENT_EXAM
}

// Special Exam Registration Model
model SpecialExamRegistration {
  id              String            @id @default(cuid())
  registrationFormId String
  studentId       String            // Reference to Student.studentId (not foreign key to allow flexibility)
  
  // Exam scope from UI
  examScope       ExamScope         @default(SPECIFIC)
  
  // For specific courses (when examScope = SPECIFIC)
  courseName      String?           // Course name when examScope is SPECIFIC
  examType        ExamType?         // MIDTERM or FINAL (nullable for ALL_MIDTERM/ALL_FINAL)
  
  // Reason and documents
  reason          String
  documentUrl     String?           // Supabase Storage URL
  
  // Approval workflow
  approvalStatus  ApprovalStatus    @default(PENDING)
  rejectionReason String?
  approvedBy      String?            // Admin user ID
  approvedAt      DateTime?
  rejectedBy      String?            // Admin user ID
  rejectedAt      DateTime?
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  registrationForm RegistrationForm @relation(fields: [registrationFormId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([registrationFormId])
  @@index([approvalStatus])
  @@map("special_exam_registrations")
}

enum ExamScope {
  ALL_MIDTERM  // all-midterm from UI
  ALL_FINAL    // all-final from UI
  SPECIFIC     // specific from UI
}

enum ExamType {
  MIDTERM
  FINAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// TIMETABLE MANAGEMENT SYSTEM (NEW FEATURES)
// ============================================

// Shift Template Model (Global shift templates)
model ShiftTemplate {
  id          String      @id @default(cuid())
  name        String      // e.g., "01 Morning Shift", "02 Noon Shift"
  studyMode   Shift       // FULL_TIME or PART_TIME
  startTime   String      // Time in HH:mm format (e.g., "07:45")
  endTime     String      // Time in HH:mm format (e.g., "09:25")
  duration    Int         // Duration in minutes
  isBreak     Boolean     @default(false) // If true, this is a break period (read-only)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  shiftBlocks ShiftBlock[]
  timetableEntries TimetableEntry[]

  @@index([studyMode])
  @@index([isActive])
  @@map("shift_templates")
}

// Shift Block Model (Links shifts to specific days)
model ShiftBlock {
  id             String       @id @default(cuid())
  shiftTemplateId String
  dayOfWeek      DayOfWeek    // SATURDAY, SUNDAY, MONDAY, etc.
  shiftTemplate  ShiftTemplate @relation(fields: [shiftTemplateId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([shiftTemplateId, dayOfWeek])
  @@index([dayOfWeek])
  @@map("shift_blocks")
}

enum DayOfWeek {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

// Academic Year Model
model AcademicYear {
  id          String     @id @default(cuid())
  name        String     @unique // e.g., "2024-25", "AY 2024-25"
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  semesters   Semester[]

  @@index([isActive])
  @@map("academic_years")
}

// Semester / Session Model
model Semester {
  id              String        @id @default(cuid())
  academicYearId  String
  name            String        // e.g., "Semester 1 (ODD)", "Semester 2 (EVEN)", "Summer Session"
  semesterType    SemesterType
  startDate       DateTime
  endDate         DateTime
  status          SemesterStatus @default(UPCOMING)
  description     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  academicYear    AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  timetables      Timetable[]

  @@index([academicYearId])
  @@index([status])
  @@map("semesters")
}

// Timetable Model (Per Department, Class, Semester)
model Timetable {
  id              String            @id @default(cuid())
  semesterId      String
  departmentId   String
  classId        String?
  studyMode      Shift              // FULL_TIME or PART_TIME
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  semester       Semester          @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  department     Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  class          Class?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  entries        TimetableEntry[]

  @@unique([semesterId, departmentId, classId, studyMode])
  @@index([semesterId])
  @@index([departmentId])
  @@index([classId])
  @@index([studyMode])
  @@map("timetables")
}

// Timetable Entry Model
model TimetableEntry {
  id              String            @id @default(cuid())
  timetableId     String
  dayOfWeek       DayOfWeek
  shiftTemplateId String
  courseName      String
  lecturerName    String
  room            String?
  entryType       TimetableEntryType @default(LECTURE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  timetable       Timetable         @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  shiftTemplate   ShiftTemplate     @relation(fields: [shiftTemplateId], references: [id], onDelete: Restrict)

  @@index([timetableId])
  @@index([dayOfWeek])
  @@index([shiftTemplateId])
  @@map("timetable_entries")
}

enum TimetableEntryType {
  LECTURE
  LABORATORY
  TUTORIAL
}

// Course Model (For Timetable System)
model Course {
  id          String   @id @default(cuid())
  code        String   // e.g., "CS101", "MATH201"
  title       String   // e.g., "Data Structures", "Discrete Mathematics"
  departmentId String?
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([departmentId])
  @@index([code])
  @@map("courses")
}

// Lecturer Model (For Timetable System)
model Lecturer {
  id          String   @id @default(cuid())
  fullName    String   // e.g., "Dr. John Nash", "Prof. Grace Hopper"
  email       String?  @unique
  phone       String?
  departmentId String?
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([departmentId])
  @@index([fullName])
  @@map("lecturers")
}

enum SemesterType {
  ODD      // Semester 1
  EVEN     // Semester 2
  SUMMER   // Summer Session
}

enum SemesterStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  INACTIVE
}
